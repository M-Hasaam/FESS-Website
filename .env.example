# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side API key from resend.com for sending Connect desk messages.
# Users configure this via the Secrets panel in the AI Studio UI.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: Verified sender identity in Resend (use onboarding@resend.dev for sandbox testing).
RESEND_FROM_EMAIL="FESS Contact Desk <onboarding@resend.dev>"

# RESEND_TO_EMAIL: Recipient inbox for FESS Connect Desk inquiries.
RESEND_TO_EMAIL="salmanahmed32121@gmail.com"

# EXTERNAL_API_BASE_URL & EXTERNAL_API_KEY: Optional upstream REST API proxied via /api/proxy/external.
# Kept strictly server-side so secret keys are never exposed to the browser.
EXTERNAL_API_BASE_URL="https://api.example.com"
EXTERNAL_API_KEY="MY_EXTERNAL_API_KEY"

# REACTBITS_LICENSE_KEY: Optional license key if pulling @reactbits-starter components via shadcn CLI.
REACTBITS_LICENSE_KEY="MY_REACTBITS_LICENSE_KEY"

